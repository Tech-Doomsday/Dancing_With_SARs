# Copy to .env.local (git-ignored). Both are optional: without them the UI works exactly as before,
# just without the verdict cache.
# The engine API (default). You can also paste a different engine URL (e.g. a Colab tunnel) at runtime
# via the engine pill in the nav bar — no restart needed; it is remembered in the browser.
NEXT_PUBLIC_ENGINE_API=http://127.0.0.1:8900
# Supabase verdict cache — READ side. The anon key is meant to be public (RLS makes the table
# read-only); never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
