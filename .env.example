# Copy to .env (git-ignored). Prefer a token: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=
# or username/password (also needs "Alaska Satellite Facility Data Access" authorized in your profile)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Where clips / chunk cache / layout indexes live. Leave empty for <repo>/data
NISAR_DATA_DIR=

# Supabase verdict cache — WRITE side (engine only). Optional: unset = verdicts are computed and
# kept in verdicts.db as before, and each run reports "cache off". Needs the SERVICE key; keep it
# server-side only, never in app-ui. Apply supabase/migrations/0001_verdict_cache.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
