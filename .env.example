# Copy to .env (git-ignored). Prefer a token: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=
# or username/password (also needs "Alaska Satellite Facility Data Access" authorized in your profile)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Where clips / chunk cache / layout indexes live. Leave empty for <repo>/data
NISAR_DATA_DIR=
