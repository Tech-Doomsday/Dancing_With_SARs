# Copy to .env (git-ignored). Prefer a token: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=
# or username/password (also needs "Alaska Satellite Facility Data Access" authorized in your profile)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Where clips / chunk cache / layout indexes live. Leave empty for <repo>/data
NISAR_DATA_DIR=

# Supabase verdict cache — WRITE side (engine only). Optional: unset = verdicts are computed and
# kept in verdicts.db as before, and each run reports "cache off". Needs the SERVICE key; keep it
# server-side only, never in app-ui. Apply supabase/migrations/0001_verdict_cache.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Location scans (POST /api/scans) fetch hundreds of MB from ASF per tile: OFF unless you opt in.
# Without this, /api/scans answers 403 and the UI disables its Scan control with that reason.
NISAR_ENABLE_SCANS=
# Extra CORS origins allowed to call this engine (comma-separated, exact scheme+host+port).
# The two localhost:3000 dev origins are always allowed. No wildcard: put auth in front of
# POST /api/scans before exposing the engine publicly.
NISAR_UI_ORIGINS=

# --- scan visibility / timeouts (added) ---
# NISAR_LOG_LEVEL=INFO            # INFO shows step start/end, ASF search timing and a MB-on-wire heartbeat every ~6 s
# NISAR_SEARCH_TIMEOUT_S=90       # stop waiting for one ASF search after this long (0 = wait forever)
# NISAR_NET_STALL_TIMEOUT_S=25    # no bytes for this long => a range read is retried
# NISAR_NET_CONCURRENCY=24        # lower (e.g. 8) on a slow / high-latency link
# NISAR_SEARCH_RETRY_INCOMPLETE=1   # re-ask ASF this many times when CMR reports a short page; a still-short listing is flagged and NOT cached
# NISAR_ASF_LOG_LEVEL=WARNING       # INFO brings back asf_search's long per-query option dumps
