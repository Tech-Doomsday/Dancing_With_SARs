# nisar-hazard-engine — environment configuration for the PYTHON ENGINE.
# Copy to .env (git-ignored). The web application under app/ has its own
# app/.env — see app/.env.example.

# --- NASA Earthdata (engine retrieval; optional but recommended) --------------------
# Prefer a token: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=
# or username/password (also needs "Alaska Satellite Facility Data Access"
# authorized in your profile)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Engine data root (optional) -----------------------------------------------------
# Where clips / chunk cache / layout indexes live. Leave empty for <repo>/data
NISAR_DATA_DIR=

# --- Engine configuration overrides (optional) ----------------------------------------
# NISAR_CONFIG=                 # path to a replacement retrieval.yaml
# NISAR_COMMON_CONFIG=          # path to a replacement common.yaml
# NISAR_<SECTION>_<KEY>=value   # retrieval/tiling overrides (e.g. NISAR_NET_CONCURRENCY=8)
# NISAR_COMMON_<SECTION>_<KEY>=value   # common-chain (P01–P13) overrides
# EQ_SAMPLE_DIR=                # real-sample folder for `python -m engine.common.debug`
                                # (default: app/data/derived/nisar-la-2008 — the integrated sample)

# NOTE: never commit real credentials. The web app's optional Earthdata bearer
# token lives in app/.env as EARTHDATA_BEARER_TOKEN (see app/.env.example).
